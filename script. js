const yesButton = document.getElementById("yesButton");
const noButton = document.getElementById("noButton");

const questionScreen =
  document.getElementById("questionScreen");

const loveScreen =
  document.getElementById("loveScreen");

const questionMessage =
  document.getElementById("questionMessage");

const bouquet =
  document.getElementById("bouquet");

const animationText =
  document.getElementById("animationText");

const finalMessage =
  document.getElementById("finalMessage");

const replayButton =
  document.getElementById("replayButton");

const confetti =
  document.getElementById("confetti");


/* ==========================================
   NO BUTTON MESSAGES
========================================== */

const noMessages = [
  "No 🥺",
  "Are you sure? 🥺",
  "Please think about it... 💜",
  "Really? 😭",
  "Are you absolutely sure? 🥹",
  "Dudu is getting sad... 💔",
  "One more chance? 🌸",
  "Think again, please? 🥺",
  "Don't break Dudu's heart 😭",
  "Pretty please? 💜",
  "Last chance? 🥹",
  "Please say yes... 💐"
];

let noCount = 0;


/* ==========================================
   NO BUTTON CLICK
========================================== */

noButton.addEventListener("click", () => {

  noCount++;

  const messageIndex =
    Math.min(
      noCount,
      noMessages.length - 1
    );

  noButton.textContent =
    noMessages[messageIndex];

  questionMessage.textContent =
    noMessages[messageIndex];

  moveNoButton();

});


/* ==========================================
   PLAYFUL NO BUTTON MOVEMENT
========================================== */

function moveNoButton() {

  const isMobile =
    window.innerWidth <= 600;


  /*
    On phones we only move the button
    a little so it stays easy to tap.
  */

  if (isMobile) {

    const x =
      Math.random() * 70 - 35;

    const y =
      Math.random() * 50 - 25;

    noButton.style.transform =
      `translate(${x}px, ${y}px)`;

    return;
  }


  /*
    Desktop movement.
  */

  const x =
    Math.random() * 100 - 50;

  const y =
    Math.random() * 60 - 30;

  noButton.style.transform =
    `translate(${x}px, ${y}px)`;
}


/* ==========================================
   YES BUTTON
========================================== */

yesButton.addEventListener("click", () => {

  /*
    Hide the question.
  */

  questionScreen.classList.add("hidden");


  /*
    Show the animation screen.
  */

  loveScreen.classList.remove("hidden");


  /*
    Reset animation.
  */

  bouquet.classList.remove("give");

  finalMessage.classList.add("hidden");

  animationText.classList.remove("hidden");


  animationText.textContent =
    "Dudu has something for Bubu... 🥺";


  /*
    Force browser to recognize a fresh animation.
  */

  void bouquet.offsetWidth;


  /*
    Start bouquet animation after
    a short dramatic pause.
  */

  setTimeout(() => {

    animationText.textContent =
      "Dudu is giving Bubu a bouquet... 💐";

    bouquet.classList.add("give");

  }, 1200);


  /*
    Bouquet reaches Bubu.
  */

  setTimeout(() => {

    animationText.textContent =
      "Bubu got the flowers! 🥹💐";

  }, 3500);


  /*
    Final celebration.
  */

  setTimeout(() => {

    animationText.classList.add("hidden");

    finalMessage.classList.remove("hidden");

    createConfetti();

  }, 4500);

});


/* ==========================================
   CONFETTI
========================================== */

function createConfetti() {

  confetti.innerHTML = "";


  const symbols = [
    "💜",
    "♥",
    "♡",
    "✦",
    "✧",
    "✨",
    "🌸",
    "💐"
  ];


  for (let i = 0; i < 80; i++) {

    const piece =
      document.createElement("span");

    piece.className =
      "confetti-piece";


    piece.textContent =
      symbols[
        Math.floor(
          Math.random() *
          symbols.length
        )
      ];


    piece.style.left =
      Math.random() * 100 + "%";


    piece.style.animationDuration =
      (2.5 + Math.random() * 3) + "s";


    piece.style.animationDelay =
      Math.random() * 1.5 + "s";


    piece.style.fontSize =
      (12 + Math.random() * 15) + "px";


    confetti.appendChild(piece);
  }


  /*
    Clean everything after animation.
  */

  setTimeout(() => {

    confetti.innerHTML = "";

  }, 7000);

}


/* ==========================================
   REPLAY BUTTON
========================================== */

replayButton.addEventListener("click", () => {

  /*
    Hide celebration.
  */

  loveScreen.classList.add("hidden");


  /*
    Show question again.
  */

  questionScreen.classList.remove("hidden");


  /*
    Reset No button.
  */

  noCount = 0;

  noButton.textContent =
    "No 🥺";

  noButton.style.transform =
    "translate(0, 0)";


  questionMessage.textContent =
    "Choose wisely... 👀💜";


  /*
    Reset bouquet animation.
  */

  bouquet.classList.remove("give");


  /*
    Reset final screen.
  */

  finalMessage.classList.add("hidden");

  animationText.classList.remove("hidden");

  animationText.textContent =
    "Dudu has something for Bubu... 🥺";

});
